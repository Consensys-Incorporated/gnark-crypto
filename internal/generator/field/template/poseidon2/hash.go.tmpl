import (
    fr "{{ .FieldPackagePath }}"
	"sync"
	"hash"
	gnarkHash "github.com/consensys/gnark-crypto/hash"
)

// Hasher{{.ParamsCompression.Width}} is the Merkle-Damgard field hasher over the permutation of width {{.ParamsCompression.Width}}.
type Hasher{{.ParamsCompression.Width}} = gnarkHash.FieldMerkleDamgardHasher[fr.Element, Digest]

// Hasher{{.ParamsSponge.Width}} is the Merkle-Damgard field hasher over the permutation of width {{.ParamsSponge.Width}}.
type Hasher{{.ParamsSponge.Width}} = gnarkHash.FieldMerkleDamgardHasher[fr.Element, [{{div .ParamsSponge.Width 2}}]fr.Element]

// Hasher is Hasher{{.ParamsCompression.Width}}.
type Hasher = Hasher{{.ParamsCompression.Width}}

// NewMerkleDamgardFieldHasher returns a Poseidon2 field hasher using the Merkle-Damgard
// construction with the default parameters.
func NewMerkleDamgardFieldHasher() *gnarkHash.FieldMerkleDamgardHasher[fr.Element, Digest] {
	return gnarkHash.NewFieldMerkleDamgardHasher[fr.Element, Digest](
		NewCompressor(NewDefaultPermutation()),
		Digest{},
	)
}

// NewMerkleDamgardFieldHasher{{.ParamsSponge.Width}} returns a Poseidon2 field hasher over the permutation of
// width {{.ParamsSponge.Width}}, using the Merkle-Damgard construction with the parameters of the sponge.
func NewMerkleDamgardFieldHasher{{.ParamsSponge.Width}}() *Hasher{{.ParamsSponge.Width}} {
	return gnarkHash.NewFieldMerkleDamgardHasher[fr.Element, [{{div .ParamsSponge.Width 2}}]fr.Element](
		NewCompressor{{.ParamsSponge.Width}}(&Permutation{params: getParameters{{.ParamsSponge.Width}}()}),
		[{{div .ParamsSponge.Width 2}}]fr.Element{},
	)
}

var getParameters{{.ParamsSponge.Width}} = sync.OnceValue(func() *Parameters {
	return NewParameters({{.ParamsSponge.Width}}, {{.ParamsSponge.FullRounds}}, {{.ParamsSponge.PartialRounds}})
})

// codec is the big endian encoding of the elements and digests of the hashers.
type codec[D gnarkHash.Block[fr.Element]] struct{}

func (codec[D]) ElementSize() int { return fr.Bytes }

func (codec[D]) DigestSize() int {
	var d D
	return len(d) * fr.Bytes
}

func (codec[D]) DecodeElement(b []byte) (fr.Element, error) {
	return fr.BigEndian.Element((*[fr.Bytes]byte)(b))
}

func (codec[D]) AppendDigest(b []byte, d D) []byte {
	var buf [fr.Bytes]byte
	for i := range len(d) {
		fr.BigEndian.PutElement(&buf, d[i])
		b = append(b, buf[:]...)
	}
	return b
}

func (c codec[D]) DecodeDigest(b []byte) (D, error) {
	var d D
	var err error
	for i := range len(d) {
		if d[i], err = c.DecodeElement(b[i*fr.Bytes : (i+1)*fr.Bytes]); err != nil {
			return d, err
		}
	}
	return d, nil
}

// NewMerkleDamgardHasher returns a Poseidon2 hasher using the Merkle-Damgard
// construction with the default parameters.
func NewMerkleDamgardHasher() gnarkHash.StateStorer {
	return gnarkHash.NewByteHasher[fr.Element, Digest](NewMerkleDamgardFieldHasher(), codec[Digest]{})
}

// NewDefaultPermutation returns a Poseidon2 permutation with the default
// recommended parameters for this field.
func NewDefaultPermutation() *Permutation {
	return &Permutation{params: GetDefaultParameters()}
}

// GetDefaultParameters returns a set of parameters for the Poseidon2 permutation.
// The default parameters are,
//
//  1. for compression:
//     - width: {{.ParamsCompression.Width}}
//     - nbFullRounds: {{.ParamsCompression.FullRounds}}
//     - nbPartialRounds: {{.ParamsCompression.PartialRounds}}
//
//  2. for sponge:
//     - width: {{.ParamsSponge.Width}}
//     - nbFullRounds: {{.ParamsSponge.FullRounds}}
//     - nbPartialRounds: {{.ParamsSponge.PartialRounds}}
var GetDefaultParameters = sync.OnceValue(func() *Parameters {
	return NewParameters(DefaultCompressionWidth, {{.ParamsCompression.FullRounds}}, {{.ParamsCompression.PartialRounds}})
})

{{- $w0 := .ParamsCompression.Width}}
{{- $w1 := .ParamsSponge.Width}}

var diag{{- $w0}} []fr.Element = make([]fr.Element, {{- $w0}})
var diag{{- $w1}} []fr.Element = make([]fr.Element, {{- $w1}})

func init() {
	// diagonal diag{{- $w0}} for the internal diagonal of the matrix of the compression layer
	// (from https://github.com/Plonky3/Plonky3 )
	{{- $i := 0}}
	{{- range $d := .ParamsCompression.DiagInternal}}
	diag{{$w0}}[{{$i}}].SetUint64({{$d}})
	{{- $i = add $i 1}}
	{{- end}}

	// diagonal diag{{- $w1}} for the internal diagonal of the matrix of the sponge layer
	// (from https://github.com/Plonky3/Plonky3 )
	{{- $i = 0}}
	{{- range $d := .ParamsSponge.DiagInternal}}
	diag{{$w1}}[{{$i}}].SetUint64({{$d}})
	{{- $i = add $i 1}}
	{{- end}}

	gnarkHash.RegisterHash(gnarkHash.POSEIDON2_{{toUpper .FF }}, func() hash.Hash {
		return NewMerkleDamgardHasher()
	})
	gnarkHash.RegisterFieldHasher(gnarkHash.POSEIDON2_{{toUpper .FF }}, func() fr.FieldHasher[Digest] {
		return NewMerkleDamgardFieldHasher()
	})
}