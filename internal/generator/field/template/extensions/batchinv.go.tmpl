{{/* batchInvertExt is the Montgomery batch inversion of an extension field
   element type, called with dict "all" . "E" <type> "V" <vector type>. */}}
{{define "batchInvertExt"}}
// BatchInvert{{.E}} returns a new slice with every element in a inverted.
// It uses Montgomery batch inversion trick.
//
// if a[i] == 0, returns result[i] = a[i]
//
// Deprecated: use [{{.V}}.BatchInvert].
//
//go:fix inline
func BatchInvert{{.E}}(a []{{.E}}) []{{.E}} {
	return {{.V}}(a).BatchInvert()
}

// BatchInvert{{.E}}Into sets res[i] to the inverse of a[i].
//
// Deprecated: use [{{.V}}.BatchInvertInto], with the destination as receiver:
// {{.V}}(res).BatchInvertInto(a).
//
//go:fix inline
func BatchInvert{{.E}}Into(res, a []{{.E}}) {
	{{.V}}(res).BatchInvertInto(a)
}

// BatchInvert{{.E}}IntoScratch is BatchInvert{{.E}}Into with caller-provided
// scratch space.
//
// Deprecated: use [{{.V}}.BatchInvertIntoScratch], with the destination as
// receiver: {{.V}}(res).BatchInvertIntoScratch(a, scratch).
//
//go:fix inline
func BatchInvert{{.E}}IntoScratch(res, a, scratch []{{.E}}) {
	{{.V}}(res).BatchInvertIntoScratch(a, scratch)
}

// BatchInvert returns a new vector with every element of vector inverted,
// using Montgomery batch inversion trick; zero elements stay zero.
func (vector {{.V}}) BatchInvert() {{.V}} {
	res := make({{.V}}, len(vector))
	res.BatchInvertInto(vector)
	return res
}

// BatchInvertInto sets vector[i] to the inverse of a[i], using Montgomery batch
// inversion trick; if a[i] == 0, vector[i] = 0. vector and a must have the same
// length.
//
// vector may be the very same slice as a (in place), but must not otherwise
// overlap it. When vector and a are distinct, BatchInvertInto does not
// allocate: vector holds the running products. In place, it needs len(a)
// elements of scratch space, which it takes from an internal pool (allocating
// only when the pool has none large enough); use BatchInvertIntoScratch to
// provide them.
{{- if .all.IsKoalaBear}}
//
// For long inputs, BatchInvertIntoScratch is faster even when vector and a are
// distinct, since keeping the running products apart saves a pass over a.
{{- end}}
func (vector {{.V}}) BatchInvertInto(a {{.V}}) {
	if len(vector) != len(a) {
		panic("{{.V}}.BatchInvertInto: vectors don't have the same length")
	}
	if len(a) == 0 {
		return
	}
	if &vector[0] != &a[0] {
		if batchInvert{{.E}}Overlap(vector, a) {
			panic("{{.V}}.BatchInvertInto: vector and a overlap without being the same slice")
		}
		batchInvert{{.E}}(vector, a, nil, batchInvert{{.E}}Lanes(len(a)))
		return
	}
	if uintptr(len(a))*unsafe.Sizeof({{.E}}{}) > batchInvert{{.E}}PoolMaxBytes {
		batchInvert{{.E}}(vector, a, make([]{{.E}}, len(a)), batchInvert{{.E}}Lanes(len(a)))
		return
	}
	scratch := batchInvert{{.E}}ScratchPool.Get().(*[]{{.E}})
	if cap(*scratch) < len(a) {
		*scratch = make([]{{.E}}, len(a))
	}
	batchInvert{{.E}}(vector, a, (*scratch)[:len(a)], batchInvert{{.E}}Lanes(len(a)))
	batchInvert{{.E}}ScratchPool.Put(scratch)
}

// BatchInvertIntoScratch is BatchInvertInto with caller-provided scratch
// space, so that it never allocates, including in place (vector may be the
// very same slice as a, but must not otherwise overlap it).
//
// scratch must have at least len(a) elements and must not overlap vector or
// a; its content on return is unspecified.
func (vector {{.V}}) BatchInvertIntoScratch(a, scratch {{.V}}) {
	if len(vector) != len(a) {
		panic("{{.V}}.BatchInvertIntoScratch: vectors don't have the same length")
	}
	if len(scratch) < len(a) {
		panic("{{.V}}.BatchInvertIntoScratch: scratch is shorter than the input")
	}
	if len(a) == 0 {
		return
	}
	scratch = scratch[:len(a)]
	if batchInvert{{.E}}Overlap(scratch, vector) || batchInvert{{.E}}Overlap(scratch, a) {
		panic("{{.V}}.BatchInvertIntoScratch: scratch overlaps vector or a")
	}
	if &vector[0] != &a[0] && batchInvert{{.E}}Overlap(vector, a) {
		panic("{{.V}}.BatchInvertIntoScratch: vector and a overlap without being the same slice")
	}
	batchInvert{{.E}}(vector, a, scratch, batchInvert{{.E}}Lanes(len(a)))
}

// batchInvert{{.E}}PoolMaxBytes is the size of the largest scratch buffer kept in
// batchInvert{{.E}}ScratchPool; larger ones are left to the garbage collector, so that a
// single long in-place call does not pin its scratch space.
const batchInvert{{.E}}PoolMaxBytes = 4 << 20

// batchInvert{{.E}}Overlap reports whether x and y share memory; both are non-empty.
func batchInvert{{.E}}Overlap(x, y []{{.E}}) bool {
	const size = unsafe.Sizeof({{.E}}{})
	xs, ys := uintptr(unsafe.Pointer(&x[0])), uintptr(unsafe.Pointer(&y[0]))
	return xs < ys+uintptr(len(y))*size && ys < xs+uintptr(len(x))*size
}

// batchInvert{{.E}}ScratchPool holds the scratch space of in-place
// {{.V}}.BatchInvertInto calls.
var batchInvert{{.E}}ScratchPool = sync.Pool{
	New: func() any { return new([]{{.E}}) },
}

{{- if .all.IsKoalaBear}}
const (
	// batchInvert{{.E}}MinLanes is the narrowest row of batchInvert{{.E}}Chains,
	// the block size of the vectorised {{.V}}.Mul.
	batchInvert{{.E}}MinLanes = 16
	// batchInvert{{.E}}MaxLanes is the widest row of batchInvert{{.E}}Chains; it
	// sizes the stack buffers, which are zeroed on every call.
	batchInvert{{.E}}MaxLanes = 256
)
{{- end}}

{{- if .all.IsKoalaBear}}
// batchInvert{{.E}}Lanes returns the number of interleaved product chains
// batchInvert{{.E}} runs for n elements, 0 meaning the scalar path. Wider rows
// amortise the per-call cost of the vectorised {{.V}}.Mul and keep more
// independent products in flight, while every chain adds to the inversion of
// the chain products; the thresholds are measured
// (BenchmarkBatchInvert{{.E}}Lanes). Without the AVX-512 kernel (arm64
// included), {{.V}}.Mul is a plain loop with no per-call cost to amortise, and
// the two interleaved chains of batchInvert{{.E}}Scalar already hide the
// latency of {{.E}}.Mul: the scalar path is the fastest at every size
// (measured on Apple M4).
func batchInvert{{.E}}Lanes(n int) int {
	if !cpu.SupportAVX512 {
		return 0
	}
	switch {
	case n < {{if eq .E "E4"}}96{{else}}48{{end}}:
		// below this, inverting the chain products costs more than the
		// chains save: the scalar path is the fastest.
		return 0
	case n >= {{if eq .E "E4"}}4096{{else}}8192{{end}}:
		return 256
	case n >= 1024:
		return 128
	case n >= {{if eq .E "E4"}}256{{else}}512{{end}}:
		return 64
	{{- if eq .E "E4"}}
	default:
		return 32
	{{- else}}
	case n >= 128:
		return 32
	default:
		return batchInvert{{.E}}MinLanes
	{{- end}}
	}
}
{{- else}}
// batchInvert{{.E}}Lanes returns 0: {{.V}}.Mul has no vectorised kernel for this
// field, so interleaved product chains would only add the inversion of their
// products, and batchInvert{{.E}} always runs the scalar path.
func batchInvert{{.E}}Lanes(int) int {
	return 0
}
{{- end}}

// batchInvert{{.E}} is the implementation of {{.V}}.BatchInvertInto: the scalar
// path (batchInvert{{.E}}Scalar) if lanes is 0{{if .all.IsKoalaBear}}, the interleaved product chains
// (batchInvert{{.E}}Chains) otherwise{{end}}. len(a) must be > 0. scratch is
// either nil, and then res and a are distinct, or len(a) elements disjoint
// from res and a, and then res may be the very same slice as a.
func batchInvert{{.E}}(res, a, scratch []{{.E}}, lanes int) {
	{{- if .all.IsKoalaBear}}
	if lanes > 0 {
		batchInvert{{.E}}Chains(res, a, scratch, lanes)
		return
	}
	{{- end}}
	prefix := res
	if &res[0] == &a[0] {
		prefix = scratch
	}
	batchInvert{{.E}}Scalar(res, a, prefix)
}

// batchInvert{{.E}}Scalar is the Montgomery batch inversion of a into res, with
// the running products in prefix. len(a) must be > 0 and len(res), len(prefix)
// >= len(a). prefix is either res, and then res and a are distinct, or
// disjoint from res and a, and then res may be the very same slice as a.
//
// It runs two interleaved chains, over the even and the odd indices, so that
// the products of one chain overlap the latency of the other's; the
// accumulators are kept out of reach of pointers so they can stay in
// registers.
func batchInvert{{.E}}Scalar(res, a, prefix []{{.E}}) {
	n := len(a)
	res, prefix = res[:n], prefix[:n]
	m := n &^ 1
	var acc0, acc1 {{.E}}
	acc0.SetOne()
	acc1.SetOne()

	for i := 0; i < m; i += 2 {
		if a[i].IsZero() {
			prefix[i].SetZero()
		} else {
			prefix[i] = acc0
			acc0.Mul(&acc0, &a[i])
		}
		if a[i+1].IsZero() {
			prefix[i+1].SetZero()
		} else {
			prefix[i+1] = acc1
			acc1.Mul(&acc1, &a[i+1])
		}
	}
	if m < n {
		if a[m].IsZero() {
			prefix[m].SetZero()
		} else {
			prefix[m] = acc0
			acc0.Mul(&acc0, &a[m])
		}
	}

	acc0, acc1 = batchInvert{{.E}}Pair(acc0, acc1)

	// a[i] is read before res[i] is written, since they may be the same.
	if m < n {
		if x := a[m]; x.IsZero() {
			res[m].SetZero()
		} else {
			res[m].Mul(&prefix[m], &acc0)
			acc0.Mul(&acc0, &x)
		}
	}
	for i := m - 2; i >= 0; i -= 2 {
		if x := a[i+1]; x.IsZero() {
			res[i+1].SetZero()
		} else {
			res[i+1].Mul(&prefix[i+1], &acc1)
			acc1.Mul(&acc1, &x)
		}
		if x := a[i]; x.IsZero() {
			res[i].SetZero()
		} else {
			res[i].Mul(&prefix[i], &acc0)
			acc0.Mul(&acc0, &x)
		}
	}
}

// batchInvert{{.E}}Pair returns the inverses of the nonzero x and y, with a
// single {{.E}} inversion.
func batchInvert{{.E}}Pair(x, y {{.E}}) ({{.E}}, {{.E}}) {
	var inv, xInv, yInv {{.E}}
	inv.Mul(&x, &y)
	inv.Inverse(&inv)
	xInv.Mul(&inv, &y)
	yInv.Mul(&inv, &x)
	return xInv, yInv
}

{{- if .all.IsKoalaBear}}

// batchInvert{{.E}}Chains runs the
// Montgomery batch inversion as interleaved product chains: the elements are
// laid out in rows, one chain per column, so that the running products of a
// row are a single vectorised {{.V}}.Mul. Rows are lanes wide, then
// batchInvert{{.E}}MinLanes wide for the remainder, and the last few elements form
// one more chain multiplied scalar by scalar. The chain products are then
// inverted together with a single {{.E}} inversion. A zero element enters its
// chain as one and gets a zero running product, so that its inverse comes out
// as zero.
//
// lanes must be a multiple of batchInvert{{.E}}MinLanes, at most
// batchInvert{{.E}}MaxLanes, and len(a) must be > 0. If scratch is nil, res and a
// must be distinct and res holds the running products. Otherwise scratch holds
// them, must be disjoint from res and a and have len(a) elements, and res
// holds a with its zeros replaced by one in between the two passes, so it may
// be the very same slice as a.
func batchInvert{{.E}}Chains(res, a, scratch []{{.E}}, lanes int) {
	n := len(a)
	inRes := scratch == nil
	prefix := scratch
	if inRes {
		prefix = res
	}

	// row boundaries: [0, wide) in rows of lanes, [wide, narrow) in rows of
	// batchInvert{{.E}}MinLanes, [narrow, n) one scalar chain.
	wide := n / lanes * lanes
	narrow := wide + (n-wide)/batchInvert{{.E}}MinLanes*batchInvert{{.E}}MinLanes

	// acc[l] is the running product of chain l, acc[lanes] that of the scalar
	// chain.
	var accBuf [batchInvert{{.E}}MaxLanes + 1]{{.E}}
	acc := accBuf[:lanes+1]
	for l := range acc {
		acc[l].SetOne()
	}
	tail := &acc[lanes]
	// row holds a row of a with its zeros replaced by one.
	var rowBuf [batchInvert{{.E}}MaxLanes]{{.E}}

	// forward pass: prefix[i] is the product of the earlier elements of the
	// chain of i, or zero if a[i] is zero.
	forward := func(j, w int) {
		row := rowBuf[:w]
		if !inRes {
			row = res[j : j+w]
		}
		p := prefix[j : j+w]
		copy(p, acc[:w])
		copy(row, a[j:j+w])
		for k := range row {
			if row[k].IsZero() {
				row[k].SetOne()
				p[k].SetZero()
			}
		}
		{{.V}}(acc[:w]).Mul(acc[:w], row)
	}
	for j := 0; j < wide; j += lanes {
		forward(j, lanes)
	}
	for j := wide; j < narrow; j += batchInvert{{.E}}MinLanes {
		forward(j, batchInvert{{.E}}MinLanes)
	}
	for i := narrow; i < n; i++ {
		if a[i].IsZero() {
			prefix[i].SetZero()
			if !inRes {
				res[i].SetOne()
			}
			continue
		}
		prefix[i] = *tail
		if !inRes {
			res[i] = a[i]
		}
		tail.Mul(tail, &a[i])
	}

	batchInvert{{.E}}ChainProducts(acc)

	// backward pass: the inverse of element i is the running inverse of its
	// chain times prefix[i]; the row is read before res is overwritten.
	for i := n - 1; i >= narrow; i-- {
		x := res[i]
		if inRes {
			x = a[i]
			if x.IsZero() {
				continue
			}
		}
		res[i].Mul(tail, &prefix[i])
		tail.Mul(tail, &x)
	}
	backward := func(j, w int) {
		row := rowBuf[:w]
		if inRes {
			copy(row, a[j:j+w])
			for k := range row {
				if row[k].IsZero() {
					row[k].SetOne()
				}
			}
		} else {
			copy(row, res[j:j+w])
		}
		{{.V}}(res[j:j+w]).Mul(acc[:w], prefix[j:j+w])
		{{.V}}(acc[:w]).Mul(acc[:w], row)
	}
	for j := narrow - batchInvert{{.E}}MinLanes; j >= wide; j -= batchInvert{{.E}}MinLanes {
		backward(j, batchInvert{{.E}}MinLanes)
	}
	for j := wide - lanes; j >= 0; j -= lanes {
		backward(j, lanes)
	}
}

// batchInvert{{.E}}ChainProducts inverts the chain products p of
// batchInvert{{.E}}Chains in place; they are all nonzero and at most
// batchInvert{{.E}}MaxLanes+1. The recursion ends since batchInvert{{.E}}Lanes
// returns 0 (the scalar path) for short inputs, and fewer lanes than elements
// otherwise.
func batchInvert{{.E}}ChainProducts(p []{{.E}}) {
	var prefix [batchInvert{{.E}}MaxLanes + 1]{{.E}}
	batchInvert{{.E}}(p, p, prefix[:len(p)], batchInvert{{.E}}Lanes(len(p)))
}
{{- end}}
{{end}}
