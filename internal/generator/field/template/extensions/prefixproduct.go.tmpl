{{/* prefixProduct is the in-place prefix product of an extension field
   vector, called with dict "E" <element type> "V" <vector type>. */}}
{{define "prefixProduct"}}
// PrefixProduct computes the prefix product of the vector in place, i.e.
// vector[i] = vector[0] * vector[1] * ... * vector[i].
//
// Long vectors are split in chunks processed in parallel, by at most nbTasks
// goroutines if nbTasks is given and positive, and at most GOMAXPROCS
// goroutines in any case.
func (vector {{.V}}) PrefixProduct(nbTasks ...int) {
	n := len(vector)
	nbWorkers := runtime.GOMAXPROCS(0)
	if len(nbTasks) == 1 && nbTasks[0] > 0 {
		nbWorkers = min(nbWorkers, nbTasks[0])
	}
	// the second pass (a ScalarMul per chunk) and the goroutines only pay off
	// on long vectors and chunks; the thresholds are measured
	// (Benchmark{{.V}}PrefixProduct, 64 cores).
	nbWorkers = min(nbWorkers, n/2048)
	if n < 1<<14 || nbWorkers < 2 {
		vector.prefixProductGeneric()
		return
	}

	// first pass: the prefix product of every chunk, independently.
	chunks := parallel.Chunks(n, nbWorkers)
	var wg sync.WaitGroup
	for _, c := range chunks {
		wg.Go(func() {
			vector[c[0]:c[1]].prefixProductGeneric()
		})
	}
	wg.Wait()

	// carry[i] is the product of the chunks before chunk i.
	carry := make([]{{.E}}, len(chunks))
	carry[1] = vector[chunks[0][1]-1]
	for i := 2; i < len(chunks); i++ {
		carry[i].Mul(&carry[i-1], &vector[chunks[i-1][1]-1])
	}

	// second pass: every chunk but the first is multiplied by its carry.
	for i := 1; i < len(chunks); i++ {
		wg.Go(func() {
			chunk := vector[chunks[i][0]:chunks[i][1]]
			chunk.ScalarMul(chunk, &carry[i])
		})
	}
	wg.Wait()
}

// prefixProductGeneric is the sequential PrefixProduct.
func (vector {{.V}}) prefixProductGeneric() {
	for i := 1; i < len(vector); i++ {
		vector[i].Mul(&vector[i], &vector[i-1])
	}
}
{{end}}

{{/* prefixProductTests tests and benchmarks prefixProduct, called with the
   same dict. */}}
{{define "prefixProductTests"}}
func Test{{.V}}PrefixProduct(t *testing.T) {
	for _, size := range []int{0, 1, 2, 3, 64, 1<<14 - 1, 1 << 14, 1<<14 + 1, 70001} {
		for _, nbTasks := range [][]int{nil, {-1}, {0}, {1}, {2}, {3}, {16}, {runtime.NumCPU()}} {
			t.Run(fmt.Sprintf("size=%d/nbTasks=%v", size, nbTasks), func(t *testing.T) {
				v := make({{.V}}, size)
				for i := range v {
					v[i].MustSetRandom()
				}
				if size > 5000 {
					// a zero in the middle of a chunk
					v[5000].SetZero()
				}
				expected := make({{.V}}, size)
				for i := range v {
					expected[i] = v[i]
					if i > 0 {
						expected[i].Mul(&expected[i], &expected[i-1])
					}
				}
				v.PrefixProduct(nbTasks...)
				require.Equal(t, expected, v)
			})
		}
	}
}

func Benchmark{{.V}}PrefixProduct(b *testing.B) {
	for _, size := range []int{1 << 12, 1 << 14, 1 << 16, 1 << 19} {
		v := make({{.V}}, size)
		for i := range v {
			v[i].MustSetRandom()
		}
		b.Run(fmt.Sprintf("generic/n=%d", size), func(b *testing.B) {
			for b.Loop() {
				v.prefixProductGeneric()
			}
		})
		b.Run(fmt.Sprintf("parallel/n=%d", size), func(b *testing.B) {
			for b.Loop() {
				v.PrefixProduct()
			}
		})
	}
}
{{end}}
