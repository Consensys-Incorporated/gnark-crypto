func TestE3Halve(t *testing.T) {
	var x E3
	x.MustSetRandom()
	y := x
	y.Halve()

	var twoInv fr.Element
	twoInv.SetUint64(2)
	twoInv.Inverse(&twoInv)
	var expected E3
	expected.MulByElement(&x, &twoInv)
	require.Equal(t, expected, y)
}

func TestE3VectorSum(t *testing.T) {
	var zero E3
	var nilVector VectorE3
	require.Equal(t, zero, nilVector.Sum())

	for _, size := range []int{0, 1, 2, 3, 15, 16, 17, 33, 100, 1 << 12} {
		t.Run(strconv.Itoa(size), func(t *testing.T) {
			v := make(VectorE3, size)
			v.MustSetRandom()

			// the sum is the inner product with ones
			ones := make(VectorE3, size)
			for i := range ones {
				ones[i].SetOne()
			}
			require.Equal(t, v.InnerProduct(ones), v.Sum())

			// size copies of x sum to x multiplied by size, as an element of the base field
			var x E3
			x.MustSetRandom()
			xs := make(VectorE3, size)
			for i := range xs {
				xs[i] = x
			}
			var n fr.Element
			n.SetUint64(uint64(size))
			var expected E3
			expected.MulByElement(&x, &n)
			require.Equal(t, expected, xs.Sum())
		})
	}
}

func TestVectorE3ElementwiseOps(t *testing.T) {
	const size = 17
	a := make(VectorE3, size)
	a.MustSetRandom()
	var c fr.Element
	c.MustSetRandom()
	b := make(VectorE3, size)
	b.MustSetRandom()
	add, sub, mul := make(VectorE3, size), make(VectorE3, size), make(VectorE3, size)
	add.Add(a, b)
	sub.Sub(a, b)
	mul.Mul(a, b)

	neg, scalarAdd, scalarSub, subFrom := make(VectorE3, size), make(VectorE3, size), make(VectorE3, size), make(VectorE3, size)
	neg.Neg(a)
	scalarAdd.ScalarAddElement(a, &c)
	scalarSub.ScalarSubElement(a, &c)
	subFrom.ScalarSubFromElement(&c, a)

	for i := range a {
		var e E3
		require.Equal(t, *e.Add(&a[i], &b[i]), add[i])
		require.Equal(t, *e.Sub(&a[i], &b[i]), sub[i])
		require.Equal(t, *e.Mul(&a[i], &b[i]), mul[i])
		require.Equal(t, *e.Neg(&a[i]), neg[i])
		require.Equal(t, *e.AddElement(&a[i], &c), scalarAdd[i])
		require.Equal(t, *e.SubElement(&a[i], &c), scalarSub[i])
		require.Equal(t, *e.SubFromElement(&c, &a[i]), subFrom[i])
	}

	// the destination may alias a
	aliased := make(VectorE3, size)
	copy(aliased, a)
	aliased.Neg(aliased)
	require.Equal(t, neg, aliased)

	// the destination may alias either input
	for _, op := range []struct {
		name string
		f    func(z, x, y VectorE3)
		want VectorE3
	}{
		{"Add", VectorE3.Add, add},
		{"Sub", VectorE3.Sub, sub},
		{"Mul", VectorE3.Mul, mul},
	} {
		copy(aliased, a)
		op.f(aliased, aliased, b)
		require.Equal(t, op.want, aliased, op.name)
		copy(aliased, b)
		op.f(aliased, a, aliased)
		require.Equal(t, op.want, aliased, op.name)
	}

	// the scalar may alias an element of the destination
	c0 := a[0].A0
	v := make(VectorE3, size)
	for _, op := range []struct {
		name    string
		vector  func(v VectorE3, c *fr.Element)
		element func(z, x *E3, c *fr.Element)
	}{
		{"ScalarAddElement", func(v VectorE3, c *fr.Element) { v.ScalarAddElement(v, c) }, func(z, x *E3, c *fr.Element) { z.AddElement(x, c) }},
		{"ScalarSubElement", func(v VectorE3, c *fr.Element) { v.ScalarSubElement(v, c) }, func(z, x *E3, c *fr.Element) { z.SubElement(x, c) }},
		{"ScalarSubFromElement", func(v VectorE3, c *fr.Element) { v.ScalarSubFromElement(c, v) }, func(z, x *E3, c *fr.Element) { z.SubFromElement(c, x) }},
	} {
		copy(v, a)
		op.vector(v, &v[0].A0)
		for i := range a {
			var e E3
			op.element(&e, &a[i], &c0)
			require.Equal(t, e, v[i], op.name)
		}
	}
}

func TestVectorE3ZeroAllocs(t *testing.T) {
	const n = 100
	v, a, b := make(VectorE3, n), make(VectorE3, n), make(VectorE3, n)
	var c fr.Element
	for _, op := range []struct {
		name string
		call func()
	}{
		{"Add", func() { v.Add(a, b) }},
		{"Sub", func() { v.Sub(a, b) }},
		{"Mul", func() { v.Mul(a, b) }},
		{"Neg", func() { v.Neg(a) }},
		{"ScalarAddElement", func() { v.ScalarAddElement(a, &c) }},
		{"ScalarSubElement", func() { v.ScalarSubElement(a, &c) }},
		{"ScalarSubFromElement", func() { v.ScalarSubFromElement(&c, a) }},
	} {
		require.Zero(t, testing.AllocsPerRun(10, op.call), op.name)
	}
}

