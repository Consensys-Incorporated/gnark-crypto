func TestE3MarshalSetBytesCanonicalRoundTrip(t *testing.T) {
	for range 100 {
		var x E3
		x.MustSetRandom()

		b := x.Marshal()
		if len(b) != BytesE3 {
			t.Fatalf("Marshal returned %d bytes, want %d", len(b), BytesE3)
		}
		coords := []*fr.Element{&x.A0, &x.A1, &x.A2}
		for i, c := range coords {
			cb := c.Bytes()
			if !bytes.Equal(b[i*fr.Bytes:(i+1)*fr.Bytes], cb[:]) {
				t.Fatalf("coefficient %d is not encoded at its expected offset", i)
			}
		}

		var y E3
		require.NoError(t, y.SetBytesCanonical(b))
		if !y.Equal(&x) {
			t.Fatal("SetBytesCanonical(Marshal(x)) != x")
		}
	}

	for _, n := range []int{0, BytesE3 - 1, BytesE3 + 1} {
		var z E3
		if err := z.SetBytesCanonical(make([]byte, n)); err == nil {
			t.Fatalf("SetBytesCanonical did not fail on %d bytes", n)
		}
	}
}

func TestE3SetInt64SetUint64(t *testing.T) {
	for _, v := range []int64{0, 1, -1, 7, -12345, 1 << 40, -(1 << 40)} {
		var z E3
		z.SetInt64(v)
		require.Truef(t, z.A1.IsZero(), "coordinate A1 is non-zero for %d", v)
		require.Truef(t, z.A2.IsZero(), "coordinate A2 is non-zero for %d", v)
		var want fr.Element
		want.SetInt64(v)
		require.Truef(t, z.A0.Equal(&want), "SetInt64(%d)", v)

		// SetInt64 and SetBigInt agree
		var zb E3
		zb.SetBigInt(big.NewInt(v))
		require.Truef(t, z.Equal(&zb), "SetInt64(%d) != SetBigInt(%d)", v, v)
	}
	for _, v := range []uint64{0, 1, 7, 12345, 1 << 40, 1<<64 - 1} {
		var z E3
		z.SetUint64(v)
		require.Truef(t, z.A1.IsZero(), "coordinate A1 is non-zero for %d", v)
		require.Truef(t, z.A2.IsZero(), "coordinate A2 is non-zero for %d", v)
		var want fr.Element
		want.SetUint64(v)
		require.Truef(t, z.A0.Equal(&want), "SetUint64(%d)", v)

		var zb E3
		zb.SetBigInt(new(big.Int).SetUint64(v))
		require.Truef(t, z.Equal(&zb), "SetUint64(%d) != SetBigInt(%d)", v, v)
	}
}

func TestE3Div(t *testing.T) {
	for range 100 {
		var x, y, q, back E3
		x.MustSetRandom()
		y.MustSetRandom()
		if y.IsZero() {
			continue
		}
		q.Div(&x, &y)
		back.Mul(&q, &y)
		require.True(t, back.Equal(&x), "(x/y)*y != x")

		// aliasing the receiver with the numerator
		var xc E3
		xc.Set(&x)
		xc.Div(&xc, &y)
		require.True(t, xc.Equal(&q), "Div must be alias-safe")
	}
}

func TestE3SetBytesCanonicalRejectsNonCanonical(t *testing.T) {
	var x E3
	x.MustSetRandom()
	good := x.Marshal()

	q := fr.Modulus()
	for i := range 3 {
		b := append([]byte(nil), good...)
		q.FillBytes(b[i*fr.Bytes : (i+1)*fr.Bytes])

		y := x
		require.Error(t, y.SetBytesCanonical(b), "coefficient %d equal to the modulus must be rejected", i)
		require.True(t, y.Equal(&x), "E3 must be unchanged on error")
	}
}

func TestE3ElementOps(t *testing.T) {
	for range 100 {
		var x, lifted, got, want E3
		var e fr.Element
		x.MustSetRandom()
		e.MustSetRandom()

		var z E3
		z.SetElement(&e)
		require.True(t, z.A0.Equal(&e))
		require.True(t, z.A1.IsZero())
		require.True(t, z.A2.IsZero())
		lifted = z

		got.AddElement(&x, &e)
		want.Add(&x, &lifted)
		require.True(t, got.Equal(&want), "AddElement")

		got.SubElement(&x, &e)
		want.Sub(&x, &lifted)
		require.True(t, got.Equal(&want), "SubElement")

		got.SubFromElement(&e, &x)
		want.Sub(&lifted, &x)
		require.True(t, got.Equal(&want), "SubFromElement")

		// aliasing of the receiver with the second operand
		got.Set(&x)
		got.SubFromElement(&e, &got)
		require.True(t, got.Equal(&want), "SubFromElement alias")

		// aliasing of the receiver with the first operand
		got.Set(&x)
		got.AddElement(&got, &e)
		want.Add(&x, &lifted)
		require.True(t, got.Equal(&want), "AddElement alias")
		got.SubElement(&got, &e)
		require.True(t, got.Equal(&x), "SubElement alias")
	}
}

func TestE3Base(t *testing.T) {
	for range 100 {
		var x, y E3
		x.MustSetRandom()

		prefix := make([]fr.Element, 2)
		prefix[0].MustSetRandom()
		prefix[1].MustSetRandom()
		base := x.AppendBase(append([]fr.Element(nil), prefix...))
		require.Len(t, base, 2+3)
		require.Equal(t, prefix, base[:2], "AppendBase must keep the prefix")

		require.True(t, y.SetBase(base[2:]).Equal(&x), "SetBase(AppendBase(x)) != x")

		// the coordinate order is the one of Marshal
		var want []byte
		for i := range base[2:] {
			b := base[2+i].Bytes()
			want = append(want, b[:]...)
		}
		require.Equal(t, want, x.Marshal())
	}

	var z E3
	for _, n := range []int{0, 3-1, 3+1} {
		require.Panics(t, func() { z.SetBase(make([]fr.Element, n)) }, "SetBase on %d elements", n)
	}
}

func TestE3ValueReceivers(t *testing.T) {
	var x E3
	x.MustSetRandom()
	x.A2.SetOne() // not in the base field

	// values print with String, like pointers
	require.Equal(t, x.String(), fmt.Sprint(x))
	require.Equal(t, x.String(), fmt.Sprint(&x))
	require.Equal(t, "{"+x.String()+"}", fmt.Sprintf("%v", struct{ E E3 }{x}))

	// read-only methods are usable on non-addressable values
	m := map[string]E3{"k": x}
	require.False(t, m["k"].IsZero())
	require.False(t, m["k"].IsOne())
	require.True(t, m["k"].Equal(&x))
	require.Equal(t, x.Marshal(), m["k"].Marshal())
	require.Equal(t, x.AppendBase(nil), m["k"].AppendBase(nil))
	require.Nil(t, m["k"].BigInt(new(big.Int)))
	require.Equal(t, x, m["k"])

	// Clone must not alias the receiver
	c := m["k"].Clone()
	require.True(t, c.Equal(&x))
	c.SetZero()
	require.False(t, x.IsZero())
	require.False(t, m["k"].IsZero())
}

func TestVectorE3MulAccHorner(t *testing.T) {
	// sizes straddle the AVX-512 block sizes and include non-aligned tails
	for _, size := range []int{0, 1, 3, 4, 5, 7, 8, 9, 15, 16, 17, 33, 65, 200} {
		t.Run(strconv.Itoa(size), func(t *testing.T) {
			a, b, v0 := randVectorE3(size), randVectorE3(size), randVectorE3(size)
			base, base2 := make(fr.Vector, size), make(fr.Vector, size)
			base.MustSetRandom()
			base2.MustSetRandom()
			var c E3
			c.MustSetRandom()

			clone := func(x VectorE3) VectorE3 { return append(make(VectorE3, 0, size), x...) }
			check := func(name string, want VectorE3, run func(v VectorE3)) {
				t.Helper()
				v := clone(v0)
				run(v)
				require.Equal(t, want, v, name)
			}
			want := func(f func(i int, z *E3)) VectorE3 {
				w := clone(v0)
				for i := range w {
					f(i, &w[i])
				}
				return w
			}
			var tmp E3

			check("MulAcc", want(func(i int, z *E3) { z.Add(z, tmp.Mul(&a[i], &b[i])) }),
				func(v VectorE3) { v.MulAcc(a, b) })
			check("ScalarMulAcc", want(func(i int, z *E3) { z.Add(z, tmp.Mul(&a[i], &c)) }),
				func(v VectorE3) { v.ScalarMulAcc(a, &c) })
			check("ScalarMulBase", want(func(i int, z *E3) { z.MulByElement(&c, &base[i]) }),
				func(v VectorE3) { v.ScalarMulBase(base, &c) })
			check("ScalarMulAccBase", want(func(i int, z *E3) { z.Add(z, tmp.MulByElement(&c, &base[i])) }),
				func(v VectorE3) { v.ScalarMulAccBase(base, &c) })
			check("ScalarMulAdd", want(func(i int, z *E3) { z.Mul(z, &c).Add(z, &b[i]) }),
				func(v VectorE3) { v.ScalarMulAdd(b, &c) })
			check("ScalarMulAddBase", want(func(i int, z *E3) { z.Mul(z, &c); z.A0.Add(&z.A0, &base2[i]) }),
				func(v VectorE3) { v.ScalarMulAddBase(base2, &c) })
			check("MulAccByElement", want(func(i int, z *E3) { z.Add(z, tmp.MulByElement(&a[i], &base[i])) }),
				func(v VectorE3) { v.MulAccByElement(a, base) })

			// vector aliases the inputs
			check("MulAcc alias", want(func(i int, z *E3) { z.Add(z, tmp.Mul(z, z)) }),
				func(v VectorE3) { v.MulAcc(v, v) })
			check("ScalarMulAcc alias", want(func(i int, z *E3) { z.Add(z, tmp.Mul(z, &c)) }),
				func(v VectorE3) { v.ScalarMulAcc(v, &c) })
			check("ScalarMulAdd alias", want(func(i int, z *E3) { tmp.Set(z); z.Mul(z, &c).Add(z, &tmp) }),
				func(v VectorE3) { v.ScalarMulAdd(v, &c) })

			if size == 0 {
				// the scalar is not read when the vectors are empty
				require.NotPanics(t, func() { v0.ScalarMul(a, nil) }, "ScalarMul on empty vectors")
				require.NotPanics(t, func() { v0.ScalarMulAcc(a, nil) }, "ScalarMulAcc on empty vectors")
				require.NotPanics(t, func() { v0.ScalarMulBase(base, nil) }, "ScalarMulBase on empty vectors")
				require.NotPanics(t, func() { v0.ScalarMulAccBase(base, nil) }, "ScalarMulAccBase on empty vectors")
				require.NotPanics(t, func() { v0.ScalarMulAdd(b, nil) }, "ScalarMulAdd on empty vectors")
				require.NotPanics(t, func() { v0.ScalarMulAddBase(base2, nil) }, "ScalarMulAddBase on empty vectors")
				return
			}
			// the scalar points into the vector being overwritten
			c0 := v0[0]
			check("ScalarMul scalar alias", want(func(i int, z *E3) { z.Mul(&a[i], &c0) }),
				func(v VectorE3) { v.ScalarMul(a, &v[0]) })
			check("ScalarMul full alias", want(func(i int, z *E3) { z.Mul(z, &c0) }),
				func(v VectorE3) { v.ScalarMul(v, &v[0]) })
			check("ScalarMulAcc scalar alias", want(func(i int, z *E3) { z.Add(z, tmp.Mul(&a[i], &c0)) }),
				func(v VectorE3) { v.ScalarMulAcc(a, &v[0]) })
			check("ScalarMulAcc full alias", want(func(i int, z *E3) { z.Add(z, tmp.Mul(z, &c0)) }),
				func(v VectorE3) { v.ScalarMulAcc(v, &v[0]) })
			check("ScalarMulBase scalar alias", want(func(i int, z *E3) { z.MulByElement(&c0, &base[i]) }),
				func(v VectorE3) { v.ScalarMulBase(base, &v[0]) })
			check("ScalarMulAccBase scalar alias", want(func(i int, z *E3) { z.Add(z, tmp.MulByElement(&c0, &base[i])) }),
				func(v VectorE3) { v.ScalarMulAccBase(base, &v[0]) })
			check("ScalarMulAdd scalar alias", want(func(i int, z *E3) { z.Mul(z, &c0).Add(z, &b[i]) }),
				func(v VectorE3) { v.ScalarMulAdd(b, &v[0]) })
			check("ScalarMulAddBase scalar alias", want(func(i int, z *E3) { z.Mul(z, &c0); z.A0.Add(&z.A0, &base2[i]) }),
				func(v VectorE3) { v.ScalarMulAddBase(base2, &v[0]) })
		})
	}
}

