import (
	"unsafe"

	fr "{{ .FieldPackagePath }}"
	"github.com/consensys/gnark-crypto/utils/cpu"
)

// Butterfly sets a = a+b and b = a-b (mod p) for each component.
func Butterfly(a, b *E3) {
	t := *a
	a.Add(a, b)
	b.Sub(&t, b)
}

// VectorE3 is a slice of E3 elements.
type VectorE3 []E3

// Vector is a slice of E3 elements.
//
// Deprecated: use VectorE3.
//
//go:fix inline
type Vector = VectorE3

// Butterfly computes the in-place butterfly between two same-length vectors:
//
//	vector[i] = vector[i] + other[i]
//	other[i]  = old vector[i] - other[i]
func (vector VectorE3) Butterfly(other VectorE3) {
	if len(vector) != len(other) {
		panic("vector.Butterfly: length mismatch")
	}
	for i := range vector {
		Butterfly(&vector[i], &other[i])
	}
}

// ButterflyPair applies Butterfly to each adjacent pair in the vector:
// (vector[0], vector[1]), (vector[2], vector[3]), ...
// Length must be even.
func (vector VectorE3) ButterflyPair() {
	if len(vector)%2 != 0 {
		panic("vector.ButterflyPair: length must be even")
	}
	for i := 0; i < len(vector); i += 2 {
		Butterfly(&vector[i], &vector[i+1])
	}
}

// MulByElement sets vector[i] = a[i] * b[i] where b[i] ∈ F_p.
func (vector VectorE3) MulByElement(a VectorE3, b fr.Vector) {
	if len(vector) != len(a) || len(vector) != len(b) {
		panic("vector.MulByElement: length mismatch")
	}
	for i := range vector {
		vector[i].MulByElement(&a[i], &b[i])
	}
}

// ScalarMulByElement sets vector[i] = a[i] * b for all i, where b ∈ F_p.
//
// Reinterprets the E3 slice as a flat fr.Vector (3 contiguous fr.Elements per E3)
// to leverage the optimized fr.Vector.ScalarMul path.
func (vector VectorE3) ScalarMulByElement(a VectorE3, b *fr.Element) {
	if len(vector) != len(a) {
		panic("vector.ScalarMulByElement: length mismatch")
	}
	if len(vector) == 0 {
		return
	}
	// E3 = {A0, A1, A2} with no padding — safe to reinterpret as 3×fr.Element.
	M := len(a) * 3
	vBase := fr.Vector(unsafe.Slice((*fr.Element)(unsafe.Pointer(&a[0])), M))
	vRes := fr.Vector(unsafe.Slice((*fr.Element)(unsafe.Pointer(&vector[0])), M))
	vRes.ScalarMul(vBase, b)
}

// ScalarMul sets vector[i] = a[i] * b for all i, where b ∈ E3.
//
// vector may be identical to a, and b may point into vector or a.
func (vector VectorE3) ScalarMul(a VectorE3, b *E3) {
	if len(vector) != len(a) {
		panic("vector.ScalarMul: length mismatch")
	}
	if len(vector) == 0 {
		return
	}
	// copy b: it may point into vector, which the loop overwrites.
	bb := *b
	for i := range vector {
		vector[i].Mul(&a[i], &bb)
	}
}

// ScalarAdd sets vector[i] = a[i] + c for all i.
//
// vector may be identical to a, and c may point into vector or a; partially
// overlapping slices are not supported.
func (vector VectorE3) ScalarAdd(a VectorE3, c *E3) {
	if len(vector) != len(a) {
		panic("vector.ScalarAdd: length mismatch")
	}
	if len(vector) == 0 {
		return
	}
	cc := *c
	for i := range vector {
		vector[i].Add(&a[i], &cc)
	}
}

// ScalarSub sets vector[i] = a[i] - c for all i.
//
// vector may be identical to a, and c may point into vector or a; partially
// overlapping slices are not supported.
func (vector VectorE3) ScalarSub(a VectorE3, c *E3) {
	if len(vector) != len(a) {
		panic("vector.ScalarSub: length mismatch")
	}
	if len(vector) == 0 {
		return
	}
	var negC E3
	negC.Neg(c)
	vector.ScalarAdd(a, &negC)
}

// ScalarSubFrom sets vector[i] = c - a[i] for all i.
//
// vector may be identical to a, and c may point into vector or a; partially
// overlapping slices are not supported.
func (vector VectorE3) ScalarSubFrom(c *E3, a VectorE3) {
	if len(vector) != len(a) {
		panic("vector.ScalarSubFrom: length mismatch")
	}
	if len(vector) == 0 {
		return
	}
	cc := *c
	for i := range vector {
		vector[i].Sub(&cc, &a[i])
	}
}

// Add sets vector[i] = a[i] + b[i]. vector may be identical to a and/or b;
// partially overlapping slices are not supported.
func (vector VectorE3) Add(a, b VectorE3) {
	if len(a) != len(vector) || len(b) != len(vector) {
		panic("vector.Add: vectors don't have the same length")
	}
	v := asBaseVector(vector)
	v.Add(asBaseVector(a), asBaseVector(b))
}

// Sub sets vector[i] = a[i] - b[i]. vector may be identical to a and/or b;
// partially overlapping slices are not supported.
func (vector VectorE3) Sub(a, b VectorE3) {
	if len(a) != len(vector) || len(b) != len(vector) {
		panic("vector.Sub: vectors don't have the same length")
	}
	v := asBaseVector(vector)
	v.Sub(asBaseVector(a), asBaseVector(b))
}

// Mul sets vector[i] = a[i] * b[i]. vector may be identical to a and/or b;
// partially overlapping slices are not supported.
func (vector VectorE3) Mul(a, b VectorE3) {
	if len(a) != len(vector) || len(b) != len(vector) {
		panic("vector.Mul: vectors don't have the same length")
	}
	for i := range vector {
		vector[i].Mul(&a[i], &b[i])
	}
}

// Neg sets vector[i] = -a[i]. vector may be identical to a; partially overlapping slices are not supported.
func (vector VectorE3) Neg(a VectorE3) {
	if len(a) != len(vector) {
		panic("vector.Neg: vectors don't have the same length")
	}
	v := asBaseVector(vector)
	v.Neg(asBaseVector(a))
}

// ScalarAddElement sets vector[i] = a[i] + c, where c is an element of the base field. vector may be identical to a, and c may point into vector; partially overlapping slices are not supported.
func (vector VectorE3) ScalarAddElement(a VectorE3, c *fr.Element) {
	if len(a) != len(vector) {
		panic("vector.ScalarAddElement: vectors don't have the same length")
	}
	cc := *c
	for i := range vector {
		vector[i].AddElement(&a[i], &cc)
	}
}

// ScalarSubElement sets vector[i] = a[i] - c, where c is an element of the base field. vector may be identical to a, and c may point into vector; partially overlapping slices are not supported.
func (vector VectorE3) ScalarSubElement(a VectorE3, c *fr.Element) {
	var negC fr.Element
	negC.Neg(c)
	vector.ScalarAddElement(a, &negC)
}

// ScalarSubFromElement sets vector[i] = c - a[i], where c is an element of the base field. vector may be identical to a, and c may point into vector; partially overlapping slices are not supported.
func (vector VectorE3) ScalarSubFromElement(c *fr.Element, a VectorE3) {
	if len(a) != len(vector) {
		panic("vector.ScalarSubFromElement: vectors don't have the same length")
	}
	cc := *c
	for i := range vector {
		vector[i].SubFromElement(&cc, &a[i])
	}
}

// AddElement sets vector[i] = a[i] + b[i] for all i, where b[i] is an element
// of the base field embedded in E3.
//
// vector may be identical to a; partially overlapping slices are not supported.
func (vector VectorE3) AddElement(a VectorE3, b fr.Vector) {
	N := len(vector)
	if len(a) != N || len(b) != N {
		panic("vector.AddElement: vectors don't have the same length")
	}
	if N == 0 {
		return
	}
	for i := range vector {
		vector[i].AddElement(&a[i], &b[i])
	}
}

// SubElement sets vector[i] = a[i] - b[i] for all i, where b[i] is an element
// of the base field embedded in E3.
//
// vector may be identical to a; partially overlapping slices are not supported.
func (vector VectorE3) SubElement(a VectorE3, b fr.Vector) {
	N := len(vector)
	if len(a) != N || len(b) != N {
		panic("vector.SubElement: vectors don't have the same length")
	}
	if N == 0 {
		return
	}
	for i := range vector {
		vector[i].SubElement(&a[i], &b[i])
	}
}

// SubFromElement sets vector[i] = a[i] - b[i] for all i, where a[i] is an
// element of the base field embedded in E3.
//
// vector may be identical to b; partially overlapping slices are not supported.
func (vector VectorE3) SubFromElement(a fr.Vector, b VectorE3) {
	N := len(vector)
	if len(a) != N || len(b) != N {
		panic("vector.SubFromElement: vectors don't have the same length")
	}
	if N == 0 {
		return
	}
	for i := range vector {
		vector[i].SubFromElement(&a[i], &b[i])
	}
}

// ScalarAddBase sets vector[i] = a[i] + c for all i, where a[i] is an element
// of the base field embedded in E3.
//
// c may point into vector; partially overlapping slices are not supported.
func (vector VectorE3) ScalarAddBase(a fr.Vector, c *E3) {
	if len(vector) != len(a) {
		panic("vector.ScalarAddBase: vectors don't have the same length")
	}
	if len(vector) == 0 {
		return
	}
	// embedding a[i] only touches the first coordinate: the others are copies
	// of c.
	cc := *c
	for i := range vector {
		r := cc
		r.A0.Add(&cc.A0, &a[i])
		vector[i] = r
	}
}

// ScalarSubBase sets vector[i] = a[i] - c for all i, where a[i] is an element
// of the base field embedded in E3.
//
// c may point into vector; partially overlapping slices are not supported.
func (vector VectorE3) ScalarSubBase(a fr.Vector, c *E3) {
	if len(vector) != len(a) {
		panic("vector.ScalarSubBase: vectors don't have the same length")
	}
	if len(vector) == 0 {
		return
	}
	var negC E3
	negC.Neg(c)
	vector.ScalarAddBase(a, &negC)
}

// ScalarSubFromBase sets vector[i] = c - a[i] for all i, where a[i] is an
// element of the base field embedded in E3.
//
// c may point into vector; partially overlapping slices are not supported.
func (vector VectorE3) ScalarSubFromBase(c *E3, a fr.Vector) {
	if len(vector) != len(a) {
		panic("vector.ScalarSubFromBase: vectors don't have the same length")
	}
	if len(vector) == 0 {
		return
	}
	cc := *c
	for i := range vector {
		r := cc
		r.A0.Sub(&cc.A0, &a[i])
		vector[i] = r
	}
}

// Sum returns the sum of all elements in the vector.
func (vector VectorE3) Sum() E3 {
	var sum E3
	for i := range vector {
		sum.Add(&sum, &vector[i])
	}
	return sum
}

// InnerProduct returns ∑ vector[i] * a[i] over E3.
func (vector VectorE3) InnerProduct(a VectorE3) E3 {
	if len(vector) != len(a) {
		panic("vector.InnerProduct: vectors don't have the same length")
	}
	var res, tmp E3
	for i := range vector {
		tmp.Mul(&vector[i], &a[i])
		res.Add(&res, &tmp)
	}
	return res
}

// InnerProductByElement returns ∑ vector[i] * a[i] where a[i] ∈ F_p.
func (vector VectorE3) InnerProductByElement(a fr.Vector) E3 {
	if len(vector) != len(a) {
		panic("vector.InnerProductByElement: vectors don't have the same length")
	}
	var res, tmp E3
	for i := range vector {
		tmp.MulByElement(&vector[i], &a[i])
		res.Add(&res, &tmp)
	}
	return res
}

// mulAccByElementThreshold is the minimum vector length above which
// ScalarMulAccBase batches through fr.Vector's Mul/Add kernels. Below it, the
// tiling overhead outweighs the win even when those kernels are accelerated.
const mulAccByElementThreshold = 64

// MulAccByElement sets vector[i] += a[i] * b[i] for all i, where b is a
// base-field vector.
//
// vector may be identical to a; partially overlapping slices are not
// supported.
func (vector VectorE3) MulAccByElement(a VectorE3, b fr.Vector) {
	if len(a) != len(vector) || len(b) != len(vector) {
		panic("vector.MulAccByElement: length mismatch")
	}
	var t E3
	for i := range vector {
		t.MulByElement(&a[i], &b[i])
		vector[i].Add(&vector[i], &t)
	}
}

// ScalarMulAcc sets vector[i] += a[i] * c for all i.
//
// vector may be identical to a, and c may point into vector or a; partially
// overlapping slices are not supported.
func (vector VectorE3) ScalarMulAcc(a VectorE3, c *E3) {
	if len(a) != len(vector) {
		panic("vector.ScalarMulAcc: length mismatch")
	}
	if len(vector) == 0 {
		return
	}
	cc := *c
	var t E3
	for i := range vector {
		t.Mul(&a[i], &cc)
		vector[i].Add(&vector[i], &t)
	}
}

// ScalarMulAccBase sets vector[i] += a[i] * c for all i, where a is a
// base-field vector and c an extension scalar.
//
// On AVX-512IFMA hardware, and for large enough vectors, the interleaved E3
// layout (A0, A1, A2 per element) is reinterpreted as a flat fr.Vector and
// processed with fr.Vector's Mul/Add, which dispatch to the AVX-512IFMA
// kernels. Without AVX-512IFMA, fr.Vector.Mul/Add fall back to the same
// per-element scalar loop this batching wraps around, so the extra tiling
// work is pure overhead — in that case we use the plain scalar loop instead.
//
// c may point into vector.
func (vector VectorE3) ScalarMulAccBase(a fr.Vector, c *E3) {
	n := len(vector)
	if n != len(a) {
		panic("vector.ScalarMulAccBase: length mismatch")
	}
	if n == 0 {
		return
	}
	cc := *c
	if !cpu.SupportAVX512IFMA || n < mulAccByElementThreshold {
		mulAccByElementGeneric(vector, a, &cc)
		return
	}
	mulAccByElementBatched(vector, a, &cc)
}

// mulAccChunk is the number of E3 elements mulAccByElementBatched processes per
// call of fr.Vector's kernels. It bounds the size of the stack buffers.
const mulAccChunk = 128

// mulAccByElementBatched implements ScalarMulAccBase by reinterpreting the
// interleaved E3 layout (A0, A1, A2 per element) as a flat fr.Vector and
// processing it with fr.Vector's Mul/Add, which dispatch to the AVX-512IFMA
// kernels on amd64, in chunks of mulAccChunk elements. alpha is copied before
// vector is written. Split out from ScalarMulAccBase so its correctness can be
// tested independently of cpu.SupportAVX512IFMA.
func mulAccByElementBatched(vector VectorE3, scale []fr.Element, alpha *E3) {
	var tiledScale, tiledAlpha, tmp [3 * mulAccChunk]fr.Element
	for i := range min(len(vector), mulAccChunk) {
		tiledAlpha[3*i] = alpha.A0
		tiledAlpha[3*i+1] = alpha.A1
		tiledAlpha[3*i+2] = alpha.A2
	}
	for len(vector) > 0 {
		m := min(len(vector), mulAccChunk)
		for i, s := range scale[:m] {
			tiledScale[3*i] = s
			tiledScale[3*i+1] = s
			tiledScale[3*i+2] = s
		}
		flatVector := asBaseVector(vector[:m])
		flatTmp := fr.Vector(tmp[:3*m])
		flatTmp.Mul(tiledScale[:3*m], tiledAlpha[:3*m])
		flatVector.Add(flatVector, flatTmp)
		vector, scale = vector[m:], scale[m:]
	}
}

func mulAccByElementGeneric(vector VectorE3, scale []fr.Element, alpha *E3) {
	var tmp E3
	for i := range vector {
		tmp.MulByElement(alpha, &scale[i])
		vector[i].Add(&vector[i], &tmp)
	}
}

// FoldPairs folds layer in pairs, as in one FRI folding round:
//
//	vector[j] = (layer[2j] + layer[2j+1]) / 2 + alpha · halfInvTwiddles[j] · (layer[2j] − layer[2j+1])
//
// FoldPairs halves the even part (p + q) itself, but multiplies the odd part
// (p − q) by halfInvTwiddles[j] as given: callers pass (2·x_j)⁻¹, where x_j is
// the evaluation point of the pair. Callers holding x_j⁻¹ must halve it first,
// or the odd term is off by a factor of 2.
//
// It panics unless len(layer) == 2·len(vector) and
// len(halfInvTwiddles) == len(vector). vector may be layer[:len(vector)]
// (folding in place); alpha may point into vector or layer. Other overlaps are
// not supported.
func (vector VectorE3) FoldPairs(layer VectorE3, halfInvTwiddles fr.Vector, alpha *E3) {
	n := len(vector)
	if len(layer) != 2*n || len(halfInvTwiddles) != n {
		panic("vector.FoldPairs: len(layer) must be 2·len(vector) and len(halfInvTwiddles) len(vector)")
	}
	if n == 0 {
		return
	}
	aa := *alpha
	foldPairsE3Generic(vector, layer, halfInvTwiddles, &aa)
}

func foldPairsE3Generic(vector, layer VectorE3, halfInvTwiddles fr.Vector, alpha *E3) {
	var s, d E3
	for j := range vector {
		p, q := &layer[2*j], &layer[2*j+1]
		s.Add(p, q)
		s.Halve()
		d.Sub(p, q)
		d.MulByElement(&d, &halfInvTwiddles[j])
		d.Mul(&d, alpha)
		vector[j].Add(&s, &d)
	}
}

// MulAcc sets vector[i] += a[i] * b[i] for all i.
//
// vector may be identical to a and/or b; partially overlapping slices are not
// supported.
func (vector VectorE3) MulAcc(a, b VectorE3) {
	N := len(vector)
	if len(a) != N || len(b) != N {
		panic("vector.MulAcc: vectors don't have the same length")
	}
	var t E3
	for i := range vector {
		t.Mul(&a[i], &b[i])
		vector[i].Add(&vector[i], &t)
	}
}

// ScalarMulBase sets vector[i] = a[i] * c for all i, where a is a base-field
// vector and c an extension scalar.
//
// c may point into vector.
func (vector VectorE3) ScalarMulBase(a fr.Vector, c *E3) {
	N := len(vector)
	if len(a) != N {
		panic("vector.ScalarMulBase: vectors don't have the same length")
	}
	if len(vector) == 0 {
		return
	}
	cc := *c
	for i := range vector {
		vector[i].MulByElement(&cc, &a[i])
	}
}

// ScalarMulAdd sets vector[i] = vector[i] * c + b[i] for all i: one Horner step
// applied across the vector.
//
// vector may be identical to b, and c may point into vector or b; partially
// overlapping slices are not supported.
func (vector VectorE3) ScalarMulAdd(b VectorE3, c *E3) {
	N := len(vector)
	if len(b) != N {
		panic("vector.ScalarMulAdd: vectors don't have the same length")
	}
	if len(vector) == 0 {
		return
	}
	cc := *c
	// compute into t first: b may alias vector.
	var t E3
	for i := range vector {
		t.Mul(&vector[i], &cc)
		vector[i].Add(&t, &b[i])
	}
}

// ScalarMulAddBase sets vector[i] = vector[i] * c + b[i] for all i, where b is
// a base-field vector: one Horner step applied across the vector.
//
// To compute a random linear combination ∑ cᵏ·colₖ of base-field columns
// whose powers of c are known, prefer ScalarMulAccBase with each power: it
// costs one extension-by-base product per element, whereas this method costs
// a full extension product. Use ScalarMulAddBase for streaming Horner
// evaluation when the powers of c are not precomputed.
//
// c may point into vector.
func (vector VectorE3) ScalarMulAddBase(b fr.Vector, c *E3) {
	N := len(vector)
	if len(b) != N {
		panic("vector.ScalarMulAddBase: vectors don't have the same length")
	}
	if len(vector) == 0 {
		return
	}
	cc := *c
	for i := range vector {
		vector[i].Mul(&vector[i], &cc)
		vector[i].A0.Add(&vector[i].A0, &b[i])
	}
}

// SetRandom sets all elements of vector to random values, returning the first error encountered, if any.
func (vector VectorE3) SetRandom() error {
	for i := range vector {
		if _, err := vector[i].SetRandom(); err != nil {
			return err
		}
	}
	return nil
}

// MustSetRandom sets all elements of vector to random values, panicking if an error is encountered.
func (vector VectorE3) MustSetRandom() {
	for i := range vector {
		vector[i].MustSetRandom()
	}
}
