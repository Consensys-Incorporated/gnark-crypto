func evaluatePolynomialExt(pol []fext.{{.ExtType}}, val {{ .FF }}.Element) fext.{{.ExtType}} {
	var res, tmp fext.{{.ExtType}}
	var acc {{ .FF }}.Element
	res.Set(&pol[0])
	acc.Set(&val)
	for i := 1; i < len(pol); i++ {
		tmp.MulByElement(&pol[i], &acc)
		res.Add(&res, &tmp)
		acc.Mul(&acc, &val)
	}
	return res
}