func evaluatePolynomial(pol []{{ .FF }}.Element, val {{ .FF }}.Element) {{ .FF }}.Element {
	var acc, res, tmp {{ .FF }}.Element
	res.Set(&pol[0])
	acc.Set(&val)
	for i := 1; i < len(pol); i++ {
		tmp.Mul(&acc, &pol[i])
		res.Add(&res, &tmp)
		acc.Mul(&acc, &val)
	}
	return res
}