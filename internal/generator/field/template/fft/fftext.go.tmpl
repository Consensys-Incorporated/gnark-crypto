{{define "genKernel FF sizeKernel sizeKernelLog2 ExtType"}}

func kerDIFNP_{{.sizeKernel}}Ext(a []fext.{{.ExtType}}, twiddles [][]{{ .FF }}.Element, stage int) {
	// code unrolled & generated by internal/generator/fft/template/fftext.go.tmpl

	{{ $n := shl 1 .sizeKernelLog2}}
	{{ $m := div $n 2}}
	{{ $split := 1}}
	{{- range $step := iterate 0 .sizeKernelLog2}} 
		{{- $offset := 0}}

		{{- $bound := mul $split $n}}
		{{- if eq $bound $n}}
			innerDIFWithTwiddlesExt(a[:{{$n}}], twiddles[stage + {{$step}}], 0, {{$m}}, {{$m}})
		{{- else}}
			{{- if eq $m 1}}
				va := fext.Vector(a[:{{$bound}}])
				va.ButterflyPair()
			{{- else}}
				for offset := 0; offset < {{$bound}}; offset += {{$n}} {
					innerDIFWithTwiddlesExt(a[offset:offset + {{$n}}], twiddles[stage + {{$step}}], 0, {{$m}}, {{$m}})
				}
			{{- end}}
		{{- end}}

		{{- $n = div $n 2}}
		{{- $m = div $n 2}}
		{{- $split = mul $split 2}}
	{{- end}}
}

func kerDITNP_{{.sizeKernel}}Ext(a []fext.{{.ExtType}}, twiddles [][]{{ .FF }}.Element, stage int) {
	// code unrolled & generated by internal/generator/fft/template/fftext.go.tmpl
	{{ $n := 2}}
	{{ $m := div $n 2}}
	{{ $split := div (shl 1 .sizeKernelLog2) 2}}
	{{- range $step := reverse (iterate 0 .sizeKernelLog2)}} 
		{{- $offset := 0}}

		{{- $bound := mul $split $n}}
		{{- if eq $bound $n}}
			innerDITWithTwiddlesExt(a[:{{$n}}], twiddles[stage + {{$step}}], 0, {{$m}}, {{$m}})
		{{- else}}
			{{- if eq $m 1}}
				va := fext.Vector(a[:{{$bound}}])
				va.ButterflyPair()
			{{- else if eq $m 2}}
				for offset := 0; offset < {{$bound}}; offset += {{$n}} {
					innerDITWithTwiddlesExtM2(a[offset:offset + {{$n}}], twiddles[stage + {{$step}}])
				}
			{{- else}}
				for offset := 0; offset < {{$bound}}; offset += {{$n}} {
					innerDITWithTwiddlesExt(a[offset:offset + {{$n}}], twiddles[stage + {{$step}}], 0, {{$m}}, {{$m}})
				}
			{{- end}}
		{{- end}}

		{{- $n = mul $n 2}}
		{{- $m = div $n 2}}
		{{- $split = div $split 2}}
	{{- end}}
}

