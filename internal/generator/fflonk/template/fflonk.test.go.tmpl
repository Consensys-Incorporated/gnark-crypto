// Test SRS re-used across tests of the KZG scheme
var testSrs *kzg.SRS
var bAlpha *big.Int

func init() {
	const srsSize = 600
	bAlpha = new(big.Int).SetInt64(42) // randomise ?
	testSrs, _ = kzg.NewSRS(ecc.NextPowerOfTwo(srsSize), bAlpha)
}

func TestSerialization(t *testing.T) {

	_, _, g, _ := {{ .CurvePackage }}.Generators()
	var proof OpeningProof
	proof.SOpeningProof.W.Set(&g)
	proof.SOpeningProof.WPrime.Set(&g)
	proof.SOpeningProof.ClaimedValues = make([][]fr.Element, 3)
	for i := range proof.SOpeningProof.ClaimedValues {
		proof.SOpeningProof.ClaimedValues[i] = make([]fr.Element, i+2)
		for j := range proof.SOpeningProof.ClaimedValues[i] {
			proof.SOpeningProof.ClaimedValues[i][j].MustSetRandom()
		}
	}
	proof.ClaimedValues = make([][][]fr.Element, 2)
	for i := range proof.ClaimedValues {
		proof.ClaimedValues[i] = make([][]fr.Element, 3)
		for j := range proof.ClaimedValues[i] {
			proof.ClaimedValues[i][j] = make([]fr.Element, i+j+1)
			for k := range proof.ClaimedValues[i][j] {
				proof.ClaimedValues[i][j][k].MustSetRandom()
			}
		}
	}

	t.Run("opening proof round trip", testutils.SerializationRoundTrip(&proof))
	t.Run("opening proof raw round trip", testutils.SerializationRoundTripRaw(&proof))
	t.Run("opening proof unsafe raw round trip", func(t *testing.T) {
		var buf bytes.Buffer
		_, err := proof.WriteRawTo(&buf)
		require.NoError(t, err)

		var reconstructed OpeningProof
		_, err = reconstructed.UnsafeReadFrom(&buf)
		require.NoError(t, err)
		require.Equal(t, proof, reconstructed)
	})
}

func TestFflonk(t *testing.T) {

	assert := require.New(t)

	// sample random polynomials of various sizes
	nbSets := 5
	p := make([][][]fr.Element, nbSets)
	for i := range nbSets {
		nbPolysInSet := 9
		p[i] = make([][]fr.Element, nbPolysInSet)
		for j := range nbPolysInSet {
			curSizePoly := j + 10
			p[i][j] = make([]fr.Element, curSizePoly)
			for k := range curSizePoly {
				p[i][j][k].MustSetRandom()
			}
		}
	}

	// sample random sets Sᵢ
	x := make([][]fr.Element, nbSets)
	for i := range nbSets {
		curSetSize := i + 4
		x[i] = make([]fr.Element, curSetSize)
		for j := range curSetSize {
			x[i][j].MustSetRandom()
		}
	}

	// commit to the folded polynomials
	digests := make([]kzg.Digest, nbSets)
	var err error
	for i := range nbSets {
		digests[i], err = FoldAndCommit(p[i], testSrs.Pk)
		assert.NoError(err)
	}

	// compute flonk opening proof
	hf := sha256.New()
	proof, err := BatchOpen(p, digests, x, hf, testSrs.Pk)
	assert.NoError(err)

	// check opening proof
	err = BatchVerify(proof, digests, x, hf, testSrs.Vk)
	assert.NoError(err)

	// tamper the proof
	proof.ClaimedValues[0][0][0].MustSetRandom()
	err = BatchVerify(proof, digests, x, hf, testSrs.Vk)
	assert.Error(err)

}

// TestBatchVerifyMalformedShape checks that BatchVerify rejects proofs whose
// dimensions are inconsistent instead of panicking with an index out of range.
// All of these shapes are reachable from deserialised, attacker supplied data.
func TestBatchVerifyMalformedShape(t *testing.T) {

	assert := require.New(t)

	// build one valid proof, then deform it in various ways
	nbSets := 3
	p := make([][][]fr.Element, nbSets)
	for i := range nbSets {
		nbPolysInSet := 4
		p[i] = make([][]fr.Element, nbPolysInSet)
		for j := range nbPolysInSet {
			curSizePoly := j + 10
			p[i][j] = make([]fr.Element, curSizePoly)
			for k := range curSizePoly {
				p[i][j][k].MustSetRandom()
			}
		}
	}

	x := make([][]fr.Element, nbSets)
	for i := range nbSets {
		curSetSize := i + 4
		x[i] = make([]fr.Element, curSetSize)
		for j := range curSetSize {
			x[i][j].MustSetRandom()
		}
	}

	digests := make([]kzg.Digest, nbSets)
	var err error
	for i := range nbSets {
		digests[i], err = FoldAndCommit(p[i], testSrs.Pk)
		assert.NoError(err)
	}

	hf := sha256.New()
	validProof, err := BatchOpen(p, digests, x, hf, testSrs.Pk)
	assert.NoError(err)
	assert.NoError(BatchVerify(validProof, digests, x, hf, testSrs.Vk))

	// deep copy so that each subtest starts from the valid proof
	cloneProof := func() OpeningProof {
		var c OpeningProof
		c.SOpeningProof.W = validProof.SOpeningProof.W
		c.SOpeningProof.WPrime = validProof.SOpeningProof.WPrime
		c.SOpeningProof.ClaimedValues = make([][]fr.Element, len(validProof.SOpeningProof.ClaimedValues))
		for i := range c.SOpeningProof.ClaimedValues {
			c.SOpeningProof.ClaimedValues[i] = append([]fr.Element{}, validProof.SOpeningProof.ClaimedValues[i]...)
		}
		c.ClaimedValues = make([][][]fr.Element, len(validProof.ClaimedValues))
		for i := range c.ClaimedValues {
			c.ClaimedValues[i] = make([][]fr.Element, len(validProof.ClaimedValues[i]))
			for j := range c.ClaimedValues[i] {
				c.ClaimedValues[i][j] = append([]fr.Element{}, validProof.ClaimedValues[i][j]...)
			}
		}
		return c
	}
	clonePoints := func() [][]fr.Element {
		c := make([][]fr.Element, len(x))
		for i := range x {
			c[i] = append([]fr.Element{}, x[i]...)
		}
		return c
	}

	testCases := []struct {
		name    string
		deform  func(proof *OpeningProof, digests *[]kzg.Digest, points *[][]fr.Element)
	}{
		{
			name: "empty pack in ClaimedValues",
			deform: func(proof *OpeningProof, _ *[]kzg.Digest, _ *[][]fr.Element) {
				proof.ClaimedValues[0] = nil
			},
		},
		{
			name: "SOpeningProof.ClaimedValues shorter than ClaimedValues",
			deform: func(proof *OpeningProof, _ *[]kzg.Digest, _ *[][]fr.Element) {
				proof.SOpeningProof.ClaimedValues = proof.SOpeningProof.ClaimedValues[:len(proof.SOpeningProof.ClaimedValues)-1]
			},
		},
		{
			name: "points row shorter than the claimed row",
			deform: func(_ *OpeningProof, _ *[]kzg.Digest, points *[][]fr.Element) {
				(*points)[0] = (*points)[0][:len((*points)[0])-1]
			},
		},
		{
			name: "points longer than ClaimedValues",
			deform: func(proof *OpeningProof, _ *[]kzg.Digest, _ *[][]fr.Element) {
				proof.ClaimedValues = proof.ClaimedValues[:len(proof.ClaimedValues)-1]
			},
		},
		{
			name: "digests shorter than points",
			deform: func(_ *OpeningProof, digests *[]kzg.Digest, _ *[][]fr.Element) {
				*digests = (*digests)[:len(*digests)-1]
			},
		},
		{
			name: "inconsistent row sizes within a pack",
			deform: func(proof *OpeningProof, _ *[]kzg.Digest, _ *[][]fr.Element) {
				proof.ClaimedValues[0][1] = proof.ClaimedValues[0][1][:len(proof.ClaimedValues[0][1])-1]
			},
		},
	}

	for _, tc := range testCases {
		t.Run(tc.name, func(t *testing.T) {
			proof := cloneProof()
			points := clonePoints()
			ds := append([]kzg.Digest{}, digests...)
			tc.deform(&proof, &ds, &points)

			// must return an error, and in particular must not panic
			err := BatchVerify(proof, ds, points, sha256.New(), testSrs.Vk)
			require.Error(t, err)
		})
	}
}

func TestCommit(t *testing.T) {

	assert := require.New(t)

	// sample polynomials
	nbPolys := 2
	p := make([][]fr.Element, nbPolys)
	for i := range nbPolys {
		p[i] = make([]fr.Element, i+10)
		for j := range i+10 {
			p[i][j].MustSetRandom()
		}
	}

	// fflonk commit to them
	var x fr.Element
	x.MustSetRandom()
	proof, err := kzg.Open(Fold(p), x, testSrs.Pk)
	assert.NoError(err)

	// check that Open(C, x) = ∑_{i<t}Pᵢ(xᵗ)xⁱ
	var xt fr.Element
	var expo big.Int
	expo.SetUint64(uint64(nbPolys))
	xt.Exp(x, &expo)
	px := make([]fr.Element, nbPolys)
	for i := range nbPolys {
		px[i] = eval(p[i], xt)
	}
	y := eval(px, x)
	assert.True(y.Equal(&proof.ClaimedValue))
}

func TestGetIthRootOne(t *testing.T) {
	assert := require.New(t)

	order := getNextDivisorRMinusOne(9)
	omega, err := getIthRootOne(order)
	assert.NoError(err)
	var orderBigInt big.Int
	orderBigInt.SetUint64(uint64(order))
	omega.Exp(omega, &orderBigInt)
	assert.True(omega.IsOne())
}

// TestFflonkRejectsZeroPoint checks that 0 is rejected as an evaluation point
// for a pack holding more than one polynomial.
//
// extendSet(p, t) maps the point 0 to <0, ω·0, .., ωᵗ⁻¹·0> = t copies of 0. The
// resulting shplonk set has a t-fold duplicate, which makes the Lagrange basis
// degenerate to the zero polynomial (fr.Element.Inverse(0) returns 0 with no
// error), so rᵢ ≡ 0 and the claimed values vanish from the shplonk check. The
// fflonk fold check degenerates at the same time: ωˡ·0 = 0 for every l, so it
// only pins one of the t claimed values per point instead of t.
//
// That is a real forgery and not only a theoretical degeneracy: at the point 0
// the fold check constrains ClaimedValues[i][0][j] alone, so the claims about
// the remaining t-1 polynomials of the pack are completely free and P₁(0) can
// be announced to be anything while the embedded shplonk proof -- and hence the
// whole Fiat-Shamir transcript -- stays untouched. Binding the claimed values
// into the transcript does *not* catch it; rejecting the degenerate point (or,
// one layer down, the duplicated extended set) does. The last subtest below
// pins that second, independent line of defence.
func TestFflonkRejectsZeroPoint(t *testing.T) {

	assert := require.New(t)

	// one pack of two polynomials, all with a zero constant term so that the
	// folded polynomial is divisible by Xᵗ (which is what an attacker would do)
	nbPolysInSet := 2
	p := make([][][]fr.Element, 1)
	p[0] = make([][]fr.Element, nbPolysInSet)
	for j := range nbPolysInSet {
		p[0][j] = make([]fr.Element, 10)
		for k := 1; k < len(p[0][j]); k++ {
			p[0][j][k].MustSetRandom()
		}
		// p[0][j][0] stays zero
	}

	digests := make([]kzg.Digest, 1)
	var err error
	digests[0], err = FoldAndCommit(p[0], testSrs.Pk)
	assert.NoError(err)

	hf := sha256.New()

	var zero fr.Element
	zeroPoints := make([][]fr.Element, 1)
	zeroPoints[0] = []fr.Element{zero}

	// the prover must refuse to produce such a proof
	_, err = BatchOpen(p, digests, zeroPoints, hf, testSrs.Pk)
	assert.ErrorIs(err, ErrZeroPoint)

	// the verifier is what an attacker controls, so pin it too: build an honest
	// proof at a non zero point and re-present it against the zero point
	nonZeroPoints := make([][]fr.Element, 1)
	nonZeroPoints[0] = make([]fr.Element, 1)
	nonZeroPoints[0][0].MustSetRandom()
	honest, err := BatchOpen(p, digests, nonZeroPoints, hf, testSrs.Pk)
	assert.NoError(err)
	assert.NoError(BatchVerify(honest, digests, nonZeroPoints, hf, testSrs.Vk))

	err = BatchVerify(honest, digests, zeroPoints, hf, testSrs.Vk)
	assert.ErrorIs(err, ErrZeroPoint)

	// the guard above is the first of two independent lines of defence: even if
	// it were removed, the set handed down to shplonk is extendSet(<0>, t) = t
	// copies of 0, which shplonk rejects on its own. Exercise that layer
	// directly, since fflonk short circuits before reaching it.
	tt := getNextDivisorRMinusOne(nbPolysInSet)
	assert.Equal(2, tt)
	extended, err := extendSet(zeroPoints[0], tt)
	assert.NoError(err)
	assert.Len(extended, tt)
	for i := range extended {
		assert.True(extended[i].IsZero())
	}
	foldedPoints := make([][]fr.Element, 1)
	foldedPoints[0] = extended
	foldedPolys := make([][]fr.Element, 1)
	foldedPolys[0] = Fold(p[0])
	_, err = shplonk.BatchOpen(foldedPolys, digests, foldedPoints, sha256.New(), testSrs.Pk)
	assert.ErrorIs(err, shplonk.ErrDuplicatePoint)

	var sProof shplonk.OpeningProof
	sProof.ClaimedValues = make([][]fr.Element, 1)
	sProof.ClaimedValues[0] = make([]fr.Element, tt)
	err = shplonk.BatchVerify(sProof, digests, foldedPoints, sha256.New(), testSrs.Vk)
	assert.ErrorIs(err, shplonk.ErrDuplicatePoint)
}

// TestFflonkAcceptsZeroPointSinglePoly is the companion positive test of
// TestFflonkRejectsZeroPoint: a pack holding a single polynomial folds with
// t = 1, so extendSet is the identity, the shplonk set <0> has no duplicate and
// the fold check pins the single claimed value exactly. Opening at 0 is then a
// perfectly valid statement and must keep working.
func TestFflonkAcceptsZeroPointSinglePoly(t *testing.T) {

	assert := require.New(t)

	assert.Equal(1, getNextDivisorRMinusOne(1))

	p := make([][][]fr.Element, 1)
	p[0] = make([][]fr.Element, 1)
	p[0][0] = make([]fr.Element, 10)
	for k := range p[0][0] {
		p[0][0][k].MustSetRandom()
	}

	digests := make([]kzg.Digest, 1)
	var err error
	digests[0], err = FoldAndCommit(p[0], testSrs.Pk)
	assert.NoError(err)

	var zero fr.Element
	points := make([][]fr.Element, 1)
	points[0] = []fr.Element{zero}

	hf := sha256.New()
	proof, err := BatchOpen(p, digests, points, hf, testSrs.Pk)
	assert.NoError(err)
	assert.NoError(BatchVerify(proof, digests, points, hf, testSrs.Vk))

	// the claimed value is the real one, P(0), i.e. the constant coefficient
	assert.True(proof.ClaimedValues[0][0][0].Equal(&p[0][0][0]))

	// and a wrong claim is still rejected
	proof.ClaimedValues[0][0][0].MustSetRandom()
	assert.Error(BatchVerify(proof, digests, points, hf, testSrs.Vk))
}

// TestFflonkRejectsCancellingClaims verifies the claim that fflonk needs no
// Fiat-Shamir change of its own, i.e. that binding the *inner* (shplonk)
// claimed values is enough to bind the *outer* ones.
//
// The fold check of BatchVerify pins, for every pack i and every point xⱼ, the t
// inner claims at <xⱼ, ωxⱼ, .., ωᵗ⁻¹xⱼ> to the evaluations of the degree t-1
// polynomial whose coefficients are the t outer claims. For xⱼ ≠ 0 those t
// points are distinct, so the Vandermonde system is invertible and inner claims
// and outer claims determine each other. Binding the inner ones therefore binds
// the outer ones.
//
// This test builds the forgery that worked before the fix: a shift of the outer
// claims whose induced shift of the inner claims lies in the kernel of
// ∑ᵢ γⁱ Z_{T\Sᵢ}(z) rᵢ(z), so the shplonk pairing check is untouched and the
// honest W, W' are reused verbatim.
func TestFflonkRejectsCancellingClaims(t *testing.T) {

	assert := require.New(t)

	// 2 packs of 2 polynomials, each pack opened at a single non zero point
	nbSets := 2
	nbPolysInSet := 2
	p := make([][][]fr.Element, nbSets)
	for i := range nbSets {
		p[i] = make([][]fr.Element, nbPolysInSet)
		for j := range nbPolysInSet {
			p[i][j] = make([]fr.Element, 8)
			for k := range p[i][j] {
				p[i][j][k].MustSetRandom()
			}
		}
	}

	digests := make([]kzg.Digest, nbSets)
	var err error
	for i := range nbSets {
		digests[i], err = FoldAndCommit(p[i], testSrs.Pk)
		assert.NoError(err)
	}

	x := make([][]fr.Element, nbSets)
	for i := range nbSets {
		x[i] = make([]fr.Element, 1)
		x[i][0].MustSetRandom()
	}

	hf := sha256.New()
	proof, err := BatchOpen(p, digests, x, hf, testSrs.Pk)
	assert.NoError(err)
	assert.NoError(BatchVerify(proof, digests, x, hf, testSrs.Vk))

	// the sets handed down to shplonk
	tt := getNextDivisorRMinusOne(nbPolysInSet)
	assert.Equal(2, tt)
	extended := make([][]fr.Element, nbSets)
	for i := range nbSets {
		extended[i], err = extendSet(x[i], tt)
		assert.NoError(err)
	}

	// replicate the pre-fix shplonk challenge derivation inline, so that the γ
	// and z solved for below are the ones the buggy verifier used
	fs := fiatshamir.NewTranscript(hf, "gamma", "z")
	for i := range extended {
		for j := range extended[i] {
			assert.NoError(fs.Bind("gamma", extended[i][j].Marshal()))
		}
	}
	for i := range digests {
		assert.NoError(fs.Bind("gamma", digests[i].Marshal()))
	}
	bGamma, err := fs.ComputeChallenge("gamma")
	assert.NoError(err)
	var gamma fr.Element
	gamma.SetBytes(bGamma)
	assert.NoError(fs.Bind("z", proof.SOpeningProof.W.Marshal()))
	bZ, err := fs.ComputeChallenge("z")
	assert.NoError(err)
	var z fr.Element
	z.SetBytes(bZ)

	// Aᵢ = γⁱ Z_{T\Sᵢ}(z)
	a := make([]fr.Element, nbSets)
	var accGamma, factor fr.Element
	accGamma.SetOne()
	for i := range nbSets {
		a[i].SetOne()
		for j := range nbSets {
			if j == i {
				continue
			}
			for k := range extended[j] {
				factor.Sub(&z, &extended[j][k])
				a[i].Mul(&a[i], &factor)
			}
		}
		a[i].Mul(&a[i], &accGamma)
		accGamma.Mul(&accGamma, &gamma)
	}

	// Shifting the constant term of the outer claims of pack i by dᵢ shifts rᵢ
	// by the constant dᵢ as well, so the pairing check is untouched as soon as
	// A₀d₀ + A₁d₁ = 0.
	var d0, d1 fr.Element
	d0.MustSetRandom()
	d1.Div(&a[0], &a[1])
	d1.Mul(&d1, &d0)
	d1.Neg(&d1)
	d := []fr.Element{d0, d1}

	forged := proof
	forged.ClaimedValues = make([][][]fr.Element, nbSets)
	forged.SOpeningProof.ClaimedValues = make([][]fr.Element, nbSets)
	for i := range nbSets {
		forged.ClaimedValues[i] = make([][]fr.Element, tt)
		for k := range tt {
			forged.ClaimedValues[i][k] = append([]fr.Element{}, proof.ClaimedValues[i][k]...)
		}
		// shift the claim about the first polynomial of the pack
		forged.ClaimedValues[i][0][0].Add(&forged.ClaimedValues[i][0][0], &d[i])
		// and the induced shift on the inner claims (a constant, since only the
		// constant coefficient of the folded claim polynomial moved)
		forged.SOpeningProof.ClaimedValues[i] = append([]fr.Element{}, proof.SOpeningProof.ClaimedValues[i]...)
		for l := range forged.SOpeningProof.ClaimedValues[i] {
			forged.SOpeningProof.ClaimedValues[i][l].Add(&forged.SOpeningProof.ClaimedValues[i][l], &d[i])
		}
	}

	// sanity: the group elements are reused as is, and the claims really moved
	assert.True(forged.SOpeningProof.W.Equal(&proof.SOpeningProof.W))
	assert.True(forged.SOpeningProof.WPrime.Equal(&proof.SOpeningProof.WPrime))
	assert.False(forged.ClaimedValues[0][0][0].Equal(&proof.ClaimedValues[0][0][0]))
	assert.False(forged.ClaimedValues[1][0][0].Equal(&proof.ClaimedValues[1][0][0]))

	assert.Error(BatchVerify(forged, digests, x, hf, testSrs.Vk),
		"fflonk BatchVerify accepted forged outer claimed values")
}
