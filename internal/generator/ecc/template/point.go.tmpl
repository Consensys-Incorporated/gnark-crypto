// mulBySeed multiplies the point q by the seed xGen in Jacobian coordinates
// using an optimized addition chain.
func (p *{{ $TJacobian }}) mulBySeed(q *{{ $TJacobian }}) *{{ $TJacobian }} {
{{- if eq .Name "bls12-381"}}
	// Generated by github.com/mmcloughlin/addchain v0.4.0.
	// Operations: 62 doublings, 1 tripling and 5 additions.

    var res {{ $TJacobian }}
    res.Triple(q)
	for range 2 {
		res.Double(&res)
	}
	res.AddAssign(q)
	for range 3 {
		res.Double(&res)
	}
	res.AddAssign(q)
	for range 9 {
		res.Double(&res)
	}
	res.AddAssign(q)
	for range 32 {
		res.Double(&res)
	}
	res.AddAssign(q)
	for range 16 {
		res.Double(&res)
	}
    p.Set(&res)
{{- else if or (eq .Name "bls12-377") (eq .Name "bw6-761")}}
	// Generated by github.com/mmcloughlin/addchain v0.4.0.
	// Operations: 60 doublings, 2 triplings, 4 additions.

	// Allocate Temporaries.
	var z = new({{ $TJacobian }})
	var (
		t0 = new({{ $TJacobian }})
		t1 = new({{ $TJacobian }})
	)

	z.Triple(q)
	t0.Double(z)
	t1.Double(t0)
	t1.Double(t1)
	t0.Triple(z)
	t0.AddAssign(t1)
	t1.Double(t0)
	for range 6 {
		t1.Double(t1)
	}
	t0.AddAssign(t1)
	for range 5 {
		t0.Double(t0)
	}
	z.AddAssign(t0)
	for range 46 {
		z.Double(z)
	}
	z.AddAssign(q)
	p.Set(z)
{{- else if eq .Name "bn254"}}
	// Addition-subtraction chain for the seed 4965661367192848881 = 0x44e992b44a6909f1
	// (point negation is free, so subtractions cost the same as additions):
	//
	//	_10      = 2*1
	//	_11      = 1 + _10
	//	_101     = _10 + _11
	//	_111     = _10 + _101
	//	_1000    = 1 + _111
	//	_1000000 = _1000 << 3
	//	_1000101 = _101 + _1000000
	//	i25      = ((_1000101 << 5 - _11) << 4 + _11) << 5
	//	i36      = ((_101 + i25) << 4 - _101) << 4 - _11
	//	i52      = ((i36 << 4 + 1) << 5 + _101) << 5
	//	i66      = ((_111 + i52) << 4 - _111) << 7 + _101
	//	return     (i66 << 5 - 1) << 4 + 1
	//
	// Operations: 60 doublings, 12 additions, 5 subtractions.

	var res, t0, x3, x5, x7 {{ $TJacobian }}

	t0.Double(q)
	x3.Set(&t0)
	x3.AddAssign(q)
	x5.Set(&t0)
	x5.AddAssign(&x3)
	x7.Set(&t0)
	x7.AddAssign(&x5)
	res.Set(&x7)
	res.AddAssign(q)
	for range 3 {
		res.Double(&res)
	}
	res.AddAssign(&x5)
	for range 5 {
		res.Double(&res)
	}
	res.SubAssign(&x3)
	for range 4 {
		res.Double(&res)
	}
	res.AddAssign(&x3)
	for range 5 {
		res.Double(&res)
	}
	res.AddAssign(&x5)
	for range 4 {
		res.Double(&res)
	}
	res.SubAssign(&x5)
	for range 4 {
		res.Double(&res)
	}
	res.SubAssign(&x3)
	for range 4 {
		res.Double(&res)
	}
	res.AddAssign(q)
	for range 5 {
		res.Double(&res)
	}
	res.AddAssign(&x5)
	for range 5 {
		res.Double(&res)
	}
	res.AddAssign(&x7)
	for range 4 {
		res.Double(&res)
	}
	res.SubAssign(&x7)
	for range 7 {
		res.Double(&res)
	}
	res.AddAssign(&x5)
	for range 5 {
		res.Double(&res)
	}
	res.SubAssign(q)
	for range 4 {
		res.Double(&res)
	}
	res.AddAssign(q)
	p.Set(&res)
{{- else if or (eq .Name "bls24-315") (eq .Name "bw6-633")}}
{{- if eq .CoordType "fptower.E4"}}
	// Over E4 the mixed additions of the windowed NAF method beat an unrolled
	// chain of full Jacobian additions.
	p.mulWindowed(q, &xGen)
{{- else}}
	// Addition-subtraction chain for the seed 3218079743 = 0xbfcfffff:
	// (3<<10 - 3)<<20 - 1 (point negation is free, so subtractions cost the
	// same as additions).
	// Operations: 30 doublings, 1 tripling, 2 subtractions.

	var t, res {{ $TJacobian }}

	t.Triple(q)
	res.Set(&t)
	for range 10 {
		res.Double(&res)
	}
	res.SubAssign(&t)
	for range 20 {
		res.Double(&res)
	}
	res.SubAssign(q)
	p.Set(&res)
{{- end}}
{{- else}}
    p.mulWindowed(q, &xGen)
{{- end}}
	return p
}
{{- end}}

