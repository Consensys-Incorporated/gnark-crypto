func GeneratePointNotIn{{ toUpper .PointName}}(f E2) {{ $TJacobian }} {
	var res, jac, a, b, c {{ $TJacobian }}
   	aff := MapToCurve2(&f)
	jac.FromAffine(&aff)
    // [x₀+1]P + ψ([x₀]P) + ψ²([x₀]P) - ψ³([2x₀]P) = [r]P
	a.mulBySeed(&jac)
	b.psi(&a)
	a.AddAssign(&jac)
