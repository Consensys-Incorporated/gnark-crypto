)

// Memory management for polynomials
// WARNING: This is not thread safe TODO: Make sure that is not a problem
// TODO: There is a lot of "unsafe" memory management here and needs to be vetted thoroughly

type sizedPool{{.ExtensionName}} struct {
	maxN  int
	pool  sync.Pool
	stats poolStats{{.ExtensionName}}
}

type inUseData{{.ExtensionName}} struct {
	allocatedFor []uintptr
	pool         *sizedPool{{.ExtensionName}}
}

type Pool{{.ExtensionName}} struct {
	//lock     sync.Mutex
	inUse    sync.Map
	subPools []sizedPool{{.ExtensionName}}
}

func (p *sizedPool{{.ExtensionName}}) get(n int) *{{.ElementType}} {
	p.stats.make(n)
	return p.pool.Get().(*{{.ElementType}})
}

func (p *sizedPool{{.ExtensionName}}) put(ptr *{{.ElementType}}) {
	p.stats.dump()
	p.pool.Put(ptr)
}

func NewPool{{.ExtensionName}}(maxN ...int) (pool Pool{{.ExtensionName}}) {

	sort.Ints(maxN)
	pool = Pool{{.ExtensionName}}{
		subPools: make([]sizedPool{{.ExtensionName}}, len(maxN)),
	}

	for i := range pool.subPools {
		subPool := &pool.subPools[i]
		subPool.maxN = maxN[i]
		subPool.pool = sync.Pool{
			New: func() any {
				subPool.stats.Allocated++
				return getDataPointer{{.ExtensionName}}(make([]{{.ElementType}}, 0, subPool.maxN))
			},
		}
	}
	return
}

func (p *Pool{{.ExtensionName}}) findCorrespondingPool(n int) *sizedPool{{.ExtensionName}} {
	poolI := 0
	for poolI < len(p.subPools) && n > p.subPools[poolI].maxN {
		poolI++
	}
	return &p.subPools[poolI] // out of bounds error here would mean that n is too large
}

func (p *Pool{{.ExtensionName}}) Make(n int) []{{.ElementType}} {
	pool := p.findCorrespondingPool(n)
	ptr := pool.get(n)
	p.addInUse(ptr, pool)
	return unsafe.Slice(ptr,n)
}

// Dump dumps a set of polynomials into the pool
func (p *Pool{{.ExtensionName}}) Dump(slices ...[]{{.ElementType}}) {
	for _, slice := range slices {
		ptr := getDataPointer{{.ExtensionName}}(slice)
		if metadata, ok := p.inUse.Load(ptr); ok {
			p.inUse.Delete(ptr)
			metadata.(inUseData{{.ExtensionName}}).pool.put(ptr)
		} else {
			panic("attempting to dump a slice not created by the pool")
		}
	}
}

func (p *Pool{{.ExtensionName}}) addInUse(ptr *{{.ElementType}}, pool *sizedPool{{.ExtensionName}}) {
	pcs := make([]uintptr, 2)
	n := runtime.Callers(3, pcs)

	if prevPcs, ok := p.inUse.Load(ptr); ok { // TODO: remove if unnecessary for security
		panic(fmt.Errorf("re-allocated non-dumped slice, previously allocated at %v", runtime.CallersFrames(prevPcs.(inUseData{{.ExtensionName}}).allocatedFor)))
	}
	p.inUse.Store(ptr, inUseData{{.ExtensionName}}{
		allocatedFor: pcs[:n],
		pool:         pool,
	})
}

func printFrame{{.ExtensionName}}(frame runtime.Frame) {
	fmt.Printf("\t%s line %d, function %s\n", frame.File, frame.Line, frame.Function)
}

func (p *Pool{{.ExtensionName}}) printInUse() {
	fmt.Println("slices never dumped allocated at:")
	p.inUse.Range(func(_, pcs any) bool {
		fmt.Println("-------------------------")

		var frame runtime.Frame
		frames := runtime.CallersFrames(pcs.(inUseData{{.ExtensionName}}).allocatedFor)
		more := true
		for more {
			frame, more = frames.Next()
			printFrame{{.ExtensionName}}(frame)
		}
		return true
	})
}

type poolStats{{.ExtensionName}} struct {
	Used          int
	Allocated     int
	ReuseRate     float64
	InUse         int
	GreatestNUsed int
	SmallestNUsed int
}

type poolsStats{{.ExtensionName}} struct {
	SubPools []poolStats{{.ExtensionName}}
	InUse    int
}

func (s *poolStats{{.ExtensionName}}) make(n int) {
	s.Used++
	s.InUse++
	if n > s.GreatestNUsed {
		s.GreatestNUsed = n
	}
	if s.SmallestNUsed == 0 || s.SmallestNUsed > n {
		s.SmallestNUsed = n
	}
}

func (s *poolStats{{.ExtensionName}}) dump() {
	s.InUse--
}

func (s *poolStats{{.ExtensionName}}) finalize() {
	s.ReuseRate = float64(s.Used) / float64(s.Allocated)
}

func getDataPointer{{.ExtensionName}}(slice []{{.ElementType}}) *{{.ElementType}} {
	return (*{{.ElementType}})(unsafe.SliceData(slice))
}

func (p *Pool{{.ExtensionName}}) PrintPoolStats() {
	InUse := 0
	subStats := make([]poolStats{{.ExtensionName}}, len(p.subPools))
	for i := range p.subPools {
		subPool := &p.subPools[i]
		subPool.stats.finalize()
		subStats[i] = subPool.stats
		InUse += subPool.stats.InUse
	}

	stats := poolsStats{{.ExtensionName}}{
		SubPools: subStats,
		InUse:    InUse,
	}
	serialized, _ := json.MarshalIndent(stats, "", "  ")
	fmt.Println(string(serialized))
	p.printInUse()
}

func (p *Pool{{.ExtensionName}}) Clone(slice []{{.ElementType}}) []{{.ElementType}} {
	res := p.Make(len(slice))
	copy(res, slice)
	return res
}